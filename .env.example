# LLM Provider Configuration ("openai", "gemini", "openai_compatible", or "offline_demo")
LLM_PROVIDER=offline_demo

# OpenAI / OpenAI-Compatible Credentials
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional: set OPENAI_BASE_URL for OpenAI-compatible endpoints (e.g., Groq, OpenRouter, local Ollama)
OPENAI_BASE_URL=

# Google Gemini Credentials
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Application Storage & Limits
DATABASE_PATH=data/analyzer.db
MAX_UPLOAD_SIZE_MB=10
LOG_LEVEL=INFO
